[Unit]
Description=Prometheus monitoring fauzi19
After=network.target

[Service]
User=fauzi19
ExecStart=/opt/fauzi19/prometheus/prometheus --config.file=/opt/fauzi19/monitoring/prometheus.yml --storage.tsdb.path=/opt/fauzi19/prom-data --storage.tsdb.retention.time=7d --web.listen-address=127.0.0.1:9090
Restart=always
RestartSec=5
MemoryMax=200M
Nice=5

[Install]
WantedBy=multi-user.target
